{
  "name": "@greendex/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/*",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./locales/*.json": "./src/locales/*.json"
  },
  "scripts": {
