{
  "name": "@greendex/calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./env": "./src/env.ts",
    "./features/landingpage/types": "./src/features/landingpage/types.ts",
    "./lib/i18n/types": "./src/lib/i18n/types.ts"
  },
  "scripts": {
    "predev": "pnpx kill-port 3000 4000 || true",
    "dev": "concurrently --kill-others \"pnpm run dev:next\" \"pnpm run dev:socket\"",
    "dev:next": "NODE_ENV=development next dev",
    "dev:memory": "NODE_OPTIONS='--max-old-space-size=4096' concurrently --kill-others \"NODE_OPTIONS='--max-old-space-size=4096' next dev\" \"pnpm run dev:socket\"",
    "dev:socket": "NODE_ENV=development dotenv -e ../../.env -- tsx --watch src/socket-server.ts",
    "dev:inspect": "PORT=3010 NEXT_DIST_DIR=.next-inspect NEXT_PUBLIC_BASE_URL=http://localhost:3010 concurrently --kill-others \"SOCKET_PORT=4001 next dev -p 3010\" \"SOCKET_PORT=4001 dotenv -e ../../.env -- tsx --watch src/socket-server.ts\"",
    "dev:inspect-brk": "PORT=3010 NEXT_DIST_DIR=.next-inspect NEXT_PUBLIC_BASE_URL=http://localhost:3010 SOCKET_PORT=4001 concurrently --kill-others \"next dev -p 3010\" \"SOCKET_PORT=4001 dotenv -e ../../.env -- tsx --watch src/socket-server.ts\"",
    "prebuild": "pnpm run generate:sri && pnpm run check:sri && turbo run db:migrate",
    "build": "printenv && next build",
    "build:cloudenv": "SKIP_ENV_VALIDATION=true next build",
    "prestart": "pnpx kill-port 3000 4000 || true && sleep 1",
    "start": "concurrently --kill-others \"next start\" \"dotenv -e ../../.env -- cross-env NODE_ENV=production tsx src/socket-server.ts\"",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "type-check": "next typegen && tsc --noEmit",
    "generate:sri": "node scripts/generate-sri.js",
    "check:sri": "node scripts/check-sri.js",
    "test": "pnpm run test:run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:cloudenv": "SKIP_ENV_VALIDATION=true vitest run --config vitest.config.cloudenv.ts",
    "test:interactive": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "HEADED=true playwright test --headed",
    "test:e2e:report": "pnpx kill-port 9323 || true && bunx playwright show-report src/__tests__/e2e/.playwright/report",
    "db:seed": "pnpm exec tsx scripts/seed.ts",
    "auth:generate": "dotenv -e ../../.env -- auth generate --config src/lib/better-auth/index.ts --output ../../packages/database/src/schemas/auth-schema.ts --yes",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@greendex/auth": "workspace:*",
    "@greendex/config": "workspace:*",
    "@greendex/database": "workspace:*",
    "@greendex/email": "workspace:*",
    "@greendex/i18n": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "^1.15.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cobe": "^2.0.1",
    "country-flag-icons": "^1.6.20",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "i18n-iso-countries": "^7.14.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.33.0",
    "motion": "^13.1.1",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "nuqs": "^2.10.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.85.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@noble/hashes": "^2.3.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "auth": "^1.7.1",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "config": {
    "scalarVersion": "1.25.0"
  }
}
