{
  "name": "@greendex/documentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "PORT=3001 next dev",
    "start": "next start --port 3001",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "type-check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@greendex/i18n": "workspace:*",
    "fumadocs-core": "16.4.10",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-ui": "16.4.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
