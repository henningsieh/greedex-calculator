{
  "name": "@greendex/documentation",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "build:cloudenv": "SKIP_ENV_VALIDATION=true next build",
    "dev": "PORT=3001 next dev",
    "start": "next start --port 3001",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "type-check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@greendex/config": "workspace:*",
    "@greendex/i18n": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "16.14.5",
    "lucide-react": "1.33.0",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  }
}
