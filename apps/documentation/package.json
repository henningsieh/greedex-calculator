{
  "name": "@greendex/documentation",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:cloudenv": "SKIP_ENV_VALIDATION=true next build",
    "dev": "PORT=3001 next dev",
    "start": "next start --port 3001",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "type-check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@greendex/config": "workspace:*",
    "@greendex/i18n": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "country-flag-icons": "^1.6.12",
    "fumadocs-core": "16.4.10",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-ui": "16.4.10",
    "next": "16.1.6",
    "next-intl": "4.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "25.1.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
