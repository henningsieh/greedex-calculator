# pnpm Configuration Optimizations for WSL Development

# Network concurrency - increased for turbo parallelism
network-concurrency=16

# Store pruning - clean up unused packages regularly
store-dir=~/.local/share/pnpm/store

# Link mode - for better performance
link-workspace-packages=true

# Lockfile - strict validation
lockfile=true

# Prefer offline mode when possible
prefer-offline=false

# Module resolution speed optimization
shamefully-hoist=false

# Development dependency deduplication
dedupe-peer-dependents=true
frozen-lockfile=false
