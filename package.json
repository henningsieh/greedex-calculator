{
  "name": "greendex-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "dotenv -v NODE_ENV=production -e .env -- turbo run build",
    "dev": "dotenv -v NODE_ENV=development -e .env -- turbo run dev",
    "lint": "turbo run lint --concurrency 1 && pnpm run check:agent-instructions",
    "check:agent-instructions": "node scripts/check-agent-instructions.mjs",
    "start": "dotenv -v NODE_ENV=production -e .env -- turbo run start",
    "format": "turbo run format",
    "test": "turbo run test --",
    "test:run": "turbo run test:run --",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "test:e2e": "turbo run test:e2e --",
    "test:e2e:ui": "turbo run test:e2e:ui --",
    "test:e2e:debug": "turbo run test:e2e:debug --",
    "test:e2e:headed": "turbo run test:e2e:headed --",
    "test:e2e:report": "turbo run test:e2e:report --"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0",
    "pnpm": "11.24.0",
    "turbo": "^2.10.12"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "husky": "^9.1.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "intent": {
    "skills": [
      "workspace:@greendex/auth",
      "workspace:@greendex/config",
      "@tanstack/react-table",
      "@tanstack/table-core",
      "dotenv"
    ]
  }
}
